# ==============================================================================
# Gauge AI Agent Evaluation Platform — Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME=Gauge

# Backend API Configuration
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8001

# PostgreSQL Configuration (Host-side port mapped to 5433 by Docker Compose)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=gauge_user
POSTGRES_PASSWORD=gauge_password
POSTGRES_DB=gauge_db

# Synchronous Database URI (Optional override; if unset, constructed from POSTGRES_* above)
# For local host to Docker Postgres: postgresql://gauge_user:gauge_password@localhost:5433/gauge_db
# For container-to-container (Docker Compose): postgresql://gauge_user:gauge_password@postgres:5432/gauge_db
DATABASE_URL=postgresql://gauge_user:gauge_password@localhost:5433/gauge_db

# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:8001

# ==============================================================================
# LLM Provider Configuration (Groq & OpenAI Integration)
# ==============================================================================
# Provider selection: 'groq', 'openai', or 'mock'
LLM_PROVIDER=groq

# Groq API Configuration (Ultra-fast LLM Inference Engine)
# Never hardcode, commit, or print real secret credentials.
GROQ_API_KEY=your_groq_api_key_here

# Configured Groq Model ID (e.g. openai/gpt-oss-20b, qwen/qwen3.8-27b, allam-2-7b)
GROQ_MODEL=openai/gpt-oss-20b

# Optional custom Groq Base URL
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Request timeout in seconds
GROQ_TIMEOUT_SECONDS=30.0

# Maximum retries on transient errors
GROQ_MAX_RETRIES=1

# OpenAI API Configuration (Alternative Real Provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30.0
OPENAI_MAX_RETRIES=1

# Default execution mode: 'auto' (uses real if API key present), 'real', or 'mock'
DEFAULT_EXECUTION_MODE=auto
